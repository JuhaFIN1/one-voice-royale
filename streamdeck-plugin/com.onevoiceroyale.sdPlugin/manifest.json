{
    "Name": "One Voice Royale",
    "Version": "1.2.3",
    "Author": "BluexDEV Softwares",
    "Description": "Control One Voice Royale — real-time speech translation — directly from your Elgato Stream Deck.",
    "Category": "One Voice Royale",
    "CategoryIcon": "icons/plugin",
    "Icon": "icons/plugin",
    "URL": "https://github.com/JuhaFIN1/one-voice-royale",
    "CodePath": "plugin.html",
    "PropertyInspectorPath": "propertyinspector/index.html",
    "SDKVersion": 2,
    "Software": {
        "MinimumVersion": "5.0"
    },
    "OS": [
        { "Platform": "windows", "MinimumVersion": "10" },
        { "Platform": "mac",     "MinimumVersion": "10.13" }
    ],
    "Actions": [
        {
            "Name": "Record Toggle",
            "UUID": "com.onevoiceroyale.record.toggle",
            "Icon": "icons/plugin",
            "Tooltip": "Start or stop recording",
            "SupportedInMultiActions": true,
            "States": [
                { "Image": "icons/plugin", "Title": "Record" },
                { "Image": "icons/plugin", "Title": "REC..." }
            ]
        },
        {
            "Name": "Wake Listen",
            "UUID": "com.onevoiceroyale.wake.toggle",
            "Icon": "icons/plugin",
            "Tooltip": "Toggle wake-word listening",
            "SupportedInMultiActions": true,
            "States": [
                { "Image": "icons/plugin", "Title": "Listen" },
                { "Image": "icons/plugin", "Title": "Listening" }
            ]
        },
        {
            "Name": "Speak Now",
            "UUID": "com.onevoiceroyale.speak",
            "Icon": "icons/plugin",
            "Tooltip": "Translate and speak the last transcript",
            "SupportedInMultiActions": true,
            "States": [
                { "Image": "icons/plugin", "Title": "Speak" }
            ]
        },
        {
            "Name": "Stop Recording",
            "UUID": "com.onevoiceroyale.stop",
            "Icon": "icons/plugin",
            "Tooltip": "Stop recording immediately",
            "SupportedInMultiActions": true,
            "States": [
                { "Image": "icons/plugin", "Title": "Stop" }
            ]
        },
        {
            "Name": "Switch Language",
            "UUID": "com.onevoiceroyale.lang",
            "Icon": "icons/plugin",
            "Tooltip": "Switch translation target language",
            "SupportedInMultiActions": true,
            "States": [
                { "Image": "icons/plugin", "Title": "Language" }
            ],
            "PropertyInspectorPath": "propertyinspector/lang.html"
        },
        {
            "Name": "Play Soundboard",
            "UUID": "com.onevoiceroyale.soundboard",
            "Icon": "icons/plugin",
            "Tooltip": "Play a soundboard sound",
            "SupportedInMultiActions": true,
            "States": [
                { "Image": "icons/plugin", "Title": "Sound" }
            ],
            "PropertyInspectorPath": "propertyinspector/soundboard.html"
        },
        {
            "Name": "Go to Soundboard Page",
            "UUID": "com.onevoiceroyale.sb.page.goto",
            "Icon": "icons/plugin",
            "Tooltip": "Jump to a specific soundboard page or folder",
            "SupportedInMultiActions": false,
            "States": [
                { "Image": "icons/plugin", "Title": "Go to Page" },
                { "Image": "icons/plugin", "Title": "● Active" }
            ],
            "PropertyInspectorPath": "propertyinspector/sbpage.html"
        },
        {
            "Name": "Voice FX Preset",
            "UUID": "com.onevoiceroyale.fx",
            "Icon": "icons/plugin",
            "Tooltip": "Apply a Voice FX preset",
            "SupportedInMultiActions": true,
            "States": [
                { "Image": "icons/plugin", "Title": "FX" }
            ],
            "PropertyInspectorPath": "propertyinspector/fx.html"
        },
        {
            "Name": "TTS Toggle",
            "UUID": "com.onevoiceroyale.tts.toggle",
            "Icon": "icons/plugin",
            "Tooltip": "Cycle between TTS backends",
            "SupportedInMultiActions": true,
            "States": [
                { "Image": "icons/plugin", "Title": "TTS" }
            ]
        },
        {
            "Name": "Open Settings",
            "UUID": "com.onevoiceroyale.settings",
            "Icon": "icons/plugin",
            "Tooltip": "Open One Voice Royale settings dialog",
            "SupportedInMultiActions": false,
            "States": [
                { "Image": "icons/plugin", "Title": "Settings" }
            ]
        }
    ]
}
